{
  "ConnectionStrings": {
    "Commissions": "Host=localhost;Port=5432;Database=commissions;Username=postgres;Password=postgres"
  },
  "Commissions": {
    "MaxUnpaidLimit": 100,
    "MaxClaimTimeout": "00:08:00"
  },
  "Users": {
    "GrpcAddress": "http://localhost:8181"
  },
  "Kestrel": {
    "Endpoints": {
      "Api": {
        "Url": "http://0.0.0.0:8082",
        "Protocols": "Http1"
      },
      "Grpc": {
        "Url": "http://0.0.0.0:8182",
        "Protocols": "Http2"
      }
    }
  },
  "Logging": {
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "IncludeScopes": true,
        "TimestampFormat": "HH:mm:ss ",
        "UseUtcTimestamp": false
      }
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
