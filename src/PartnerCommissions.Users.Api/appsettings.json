{
  "ConnectionStrings": {
    "Users": "Host=localhost;Port=5432;Database=users;Username=postgres;Password=postgres;GSS Encryption Mode=Disable"
  },
  "Users": {
    "MaxTreeDepth": 10
  },
  "Metrics": {
    "MeterName": "PartnerCommissions.Users",
    "UsersCreated": "users.created"
  },
  "Kestrel": {
    "Endpoints": {
      "Api": {
        "Url": "http://0.0.0.0:8081",
        "Protocols": "Http1"
      },
      "Grpc": {
        "Url": "http://0.0.0.0:8181",
        "Protocols": "Http2"
      }
    }
  },
  "Logging": {
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "IncludeScopes": true,
        "TimestampFormat": "HH:mm:ss ",
        "UseUtcTimestamp": false
      }
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
