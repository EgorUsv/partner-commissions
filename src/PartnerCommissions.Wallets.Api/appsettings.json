{
  "ConnectionStrings": {
    "Wallets": "Host=localhost;Port=5432;Database=wallets;Username=postgres;Password=postgres"
  },
  "Wallets": {
    "BatchLimit": 100,
    "ClaimTimeout": "00:05:00",
    "PayoutInterval": "00:01:00",
    "AckRetry": "00:00:30",
    "MaxCreditAttempts": 5
  },
  "Commissions": {
    "GrpcAddress": "http://localhost:8182"
  },
  "Metrics": {
    "MeterName": "PartnerCommissions.Wallets",
    "CommissionsCredited": "wallets.commissions.credited",
    "CommissionsAlreadyPaid": "wallets.commissions.already_paid",
    "CommissionsAcked": "wallets.commissions.acked"
  },
  "Kestrel": {
    "Endpoints": {
      "Api": {
        "Url": "http://0.0.0.0:8083",
        "Protocols": "Http1"
      }
    }
  },
  "Logging": {
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "IncludeScopes": true,
        "TimestampFormat": "HH:mm:ss ",
        "UseUtcTimestamp": false
      }
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
